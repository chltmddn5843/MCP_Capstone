eometry></mxCell><mxCell id="s13" value="⑪ Slack 팀 채널 발송 (실패 시 재시도)" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="968" y="748" as="sourcePoint"/><mxPoint x="1492" y="748" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s14" value="⑫ 관리자 GET /review-runs · PATCH /departments/{id}" style="rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="158" y="792" as="sourcePoint"/><mxPoint x="412" y="792" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s15" value="⑬ 보낸 팀 · 보류 사유 표" style="rounded=1;html=1;endArrow=open;endFill=0;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="412" y="836" as="sourcePoint"/><mxPoint x="158" y="836" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="6. F2 흐름"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1024" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="F2 업무별 모델 추천 — 요청 흐름 (202 + SSE)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="30" as="geometry"/></mxCell><mxCell id="intro" value="&lt;b&gt;웹에서 하는 일&lt;/b&gt; · 직원이 'AI 비서'에 업무를 설명한다(예: 문의 1,000건/일 10개 유형 분류, 비용 줄이기). 진행 상황이 실시간으로 보이고, 추천 모델·근거·예상 월 비용을 받는다. 원하면 테스트 적용을 요청한다." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fafafa;strokeColor=#999999;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="45" width="1640" height="55" as="geometry"/></mxCell><mxCell id="g_프론트"