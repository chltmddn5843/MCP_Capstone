e14" value="수동 재발행" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#b58900;exitX=0;exitY=0.5;entryX=0.4;entryY=1;" edge="1" parent="1" source="adm" target="q"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="640"/><mxPoint x="640" y="270"/><mxPoint x="580" y="270"/></Array></mxGeometry></mxCell><mxCell id="rules" value="&lt;b&gt;규칙&lt;/b&gt;&lt;br&gt;• 같은 작업을 두 번 실행해도 결과가 같다: 실행 API는 Idempotency-Key, 좌석 배정은 (contract_id, employee_id) 유니크&lt;br&gt;• 재시도는 일시 오류만. 권한·검증 오류(4xx)는 바로 failed&lt;br&gt;• 시연: mock_vendor ?fail_rate=0.5 로 503을 일부러 내고 재시도 → 성공 / DLQ 를 화면에서 보여준다&lt;br&gt;• 관측: job_runs 와 로그에 같은 trace_id, RabbitMQ 관리 UI(15672)에서 큐 길이 확인" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fafafa;strokeColor=#999999;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="560" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4. 기능별 한눈에"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t4" value="기능별 구조 한눈에 — 웹 화면 → API → 처리 → DB" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="rl_web" value="프론트&lt;br&gt;&lt;span style='font-weight:normal;font-size:10px'&gt;Streamlit&lt;br&gt;웹에서 하는 일&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="150" height="120" as="geometry"/></mxCell><mxCell id="rl_api" value="서버 API&lt;br&gt;&lt;span style='font-weight:normal;font-size:10px'&gt;FastAPI backend&lt;br&gt;JWT · 업무 규칙&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="150" height="105" as="geometry"/></mxCell><mxCell id="rl_proc" value="서버 처리&lt;br&gt;&lt;span style='font-weight:normal;font-size:10px'&gt;LangGraph · FastMCP&lt;br&gt;Celery · RabbitMQ&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="435" width="150" height="115" as="geometry"/></mxCell><mxCell id="rl_db" value="DB&lt;br&gt;&lt;span style='font-weight:normal;font-size:10px'&gt;PostgreSQL 16&lt;br&gt;SQLAlchemy · Alembic&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="580" width="150" height="95" as="geometry"/></mxCell><mxCell id="fh0" value="&lt;b&gt;F1 업데이트 기반 활용 제안&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;AI 활용 지원 · 자동&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4d4d4d;strokeColor=#333333;fontColor=#ffffff;fontStyle=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="190" y="70" width="350" height="60" as="geometry"/></mxCell><mxCell id="f0_web" value="&lt;b&gt;관리자&lt;/b&gt; '자동 제안 기록' 탭&lt;br&gt;· 업데이트별 보낸 팀·보류 사유 확인&lt;br&gt;· 팀별 자동 발송 켜기/끄기&lt;br&gt;&lt;b&gt;직원&lt;/b&gt; 받은 제안에 도움 됨 / 관련 없음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="150" width="350" height="120" as="geometry"/></mxCell><mxCell id="f0_api" value="GET /review-runs&lt;br&gt;PATCH /departments/{id}&lt;br&gt;GET /suggestions&lt;br&gt;POST /suggestions/{id}/feedback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="300" width="350" height="105" as="geometry"/></mxCell><mxCell id="f0_proc" value="beat 주 1회 → collect_release_notes&lt;br&gt;→ agent &lt;b&gt;review_update&lt;/b&gt; (system)&lt;br&gt;→ MCP find_relevant_tasks · save_suggestion&lt;br&gt;→ 알림 정책 통과 → notify 큐 → Slack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="435" width="350" height="115" as="geometry"/></mxCell><mxCell id="f0_db" value="vendor_updates · suggestions&lt;br&gt;review_runs · feedback&lt;br&gt;suggestion_holds · departments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="580" width="350" height="95" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="f0_web" target="f0_api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="f0_api" target="f0_proc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="f0_proc" target="f0_db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fh1" value="&lt;b&gt;F2 업무별 모델 추천&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;AI 활용 지원 · 대화&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4d4d4d;strokeColor=#333333;fontColor=#ffffff;fontStyle=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="560" y="70" width="350" height="60" as="geometry"/></mxCell><mxCell id="f1_web" value="&lt;b&gt;직원&lt;/b&gt; 'AI 비서' 채팅&lt;br&gt;· 업무 설명 입력 → 진행 표시&lt;br&gt;· 추천 모델·근거·예상 비용 확인&lt;br&gt;· 테스트 적용 요청" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="350" height="120" as="geometry"/></mxCell><mxCell id="f1_api" value="POST /ai/tasks → 202&lt;br&gt;GET /ai/tasks/{id}/stream (SSE)&lt;br&gt;(MCP 경유) GET /models · GET /eval-results&lt;br&gt;POST /estimates/task-cost · POST /plans" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="300" width="350" height="105" as="geometry"/></mxCell><mxCell id="f1_proc" value="agent &lt;b&gt;classify_intent&lt;/b&gt; → collect_conditions&lt;br&gt;(조건 부족하면 되묻고 종료)&lt;br&gt;평가 결과 없으면 추천 보류&lt;br&gt;→ model_change 처리 요청 (test)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="435" width="350" height="115" as="geometry"/></mxCell><mxCell id="f1_db" value="models · eval_results&lt;br&gt;usage_records · action_plans&lt;br&gt;unmet_needs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="580" width="350" height="95" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="f1_web" target="f1_api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="f1_api" target="f1_proc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="f1_proc" target="f1_db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fh2" value="&lt;b&gt;F3 사용량·비용 모니터링&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;AI 운영 지원&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4d4d4d;strokeColor=#333333;fontColor=#ffffff;fontStyle=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="930" y="70" width="350" height="60" as="geometry"/></mxCell><mxCell id="f2_web" value="&lt;b&gt;관리자&lt;/b&gt; '비용 경보' 탭&lt;br&gt;· 프로젝트별 사용 추이·경고 확인&lt;br&gt;· 원인 후보·근거 보기&lt;br&gt;· 대응안 하나 선택" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="150" width="350" height="120" as="geometry"/></mxCell><mxCell id="f2_api" value="GET /usage?group_by=model|api_key|input_length&lt;br&gt;GET /anomalies · GET /anomalies/{id}&lt;br&gt;POST /plans (budget_review)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="300" width="350" height="105" as="geometry"/></mxCell><mxCell id="f2_proc" value="beat 10~30분 → collect_usage (재시도)&lt;br&gt;→ check_thresholds → anomalies&lt;br&gt;→ agent &lt;b&gt;investigate_anomaly&lt;/b&gt; (system)&lt;br&gt;→ MCP get_usage_breakdown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="435" width="350" height="115" as="geometry"/></mxCell><mxCell id="f2_db" value="usage_records · api_keys&lt;br&gt;projects · anomalies&lt;br&gt;action_plans" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="580" width="350" height="95" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="f2_web" target="f2_api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="f2_api" target="f2_proc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="f2_proc" target="f2_db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fh3" value="&lt;b&gt;F4 자산·이용권 운영&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;SW 운영 지원&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4d4d4d;strokeColor=#333333;fontColor=#ffffff;fontStyle=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1300" y="70" width="350" height="60" as="geometry"/></mxCell><mxCell id="f3_web" value="&lt;b&gt;직원&lt;/b&gt; 이용권 신청 · 사용 의사 응답&lt;br&gt;&lt;b&gt;관리자&lt;/b&gt; '이용권' 탭 현황&lt;br&gt;(구매·배정·미배정·저사용)&lt;br&gt;'승인함'에서 AI 의견 보고 승인·반려" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="150" width="350" height="120" as="geometry"/></mxCell><mxCell id="f3_api" value="GET /inventory&lt;br&gt;POST /plans (seat_assign)&lt;br&gt;POST /plans/{id}/approve · /reject&lt;br&gt;POST /confirmations · /{id}/answer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="300" width="350" height="105" as="geometry"/></mxCell><mxCell id="f3_proc" value="좌석 있음 → 즉시 &lt;b&gt;execute_plan&lt;/b&gt; 큐 → Mock 벤더&lt;br&gt;좌석 없음 → 승인 대기&lt;br&gt;+ agent &lt;b&gt;review_seat_request&lt;/b&gt; (AI 의견)&lt;br&gt;회수·재배정은 사용 의사 확인 뒤" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="435" width="350" height="115" as="geometry"/></mxCell><mxCell id="f3_db" value="contracts · seat_assignments&lt;br&gt;action_plans · confirmations&lt;br&gt;savings_ledger · audit_log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="580" width="350" height="95" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="f3_web" target="f3_api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="f3_api" target="f3_proc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="f3_proc" target="f3_db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="common" value="&lt;b&gt;공통&lt;/b&gt; · 로그인 POST /auth/login → JWT (모든 요청 Authorization) · 데이터 변경은 처리 요청(action_plans)으로만 · 모든 변경은 audit_log · 서비스 사이 X-Trace-Id 전달 · 화면은 agent 주소를 모르고 backend /ai/tasks만 부른다" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fafafa;strokeColor=#999999;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="1630" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="5. F1 흐름"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="F1 업데이트 기반 활용 제안 — 요청 흐름" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="30" as="geometry"/></mxCell><mxCell id="intro" value="&lt;b&gt;웹에서 하는 일&lt;/b&gt; · 사람이 시작하지 않는다(주 1회 자동). 관리자는 '자동 제안 기록' 탭에서 어느 팀에 무엇을 보냈고 왜 안 보냈는지 확인하고, 팀별 발송을 켜고 끈다. 직원은 받은 제안에 반응한다." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fafafa;strokeColor=#999999;align=left;spacingLeft=8;fontSize=11;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="45" width="1640" height="55" as="geometry"/></mxCell><mxCell id="g_프론트" value="프론트" style="rounded=0;html=1;fillColor=#6c8ebf;fontColor=#ffffff;fontStyle=1;strokeColor=none;" vertex="1" parent="1"><mxGe