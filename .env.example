ANTHROPIC_API_KEY=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
BACKEND_URL=http://localhost:8000
AGENT_URL=http://localhost:8002
MCP_WORK_URL=http://localhost:8010/mcp
MCP_DOCS_URL=http://localhost:8011/mcp
DATABASE_URL=postgresql+psycopg://capstone:capstone@localhost:5432/capstone
POSTGRES_USER=capstone
POSTGRES_PASSWORD=capstone
POSTGRES_DB=capstone

# 에이전트 런타임
LLM_MODEL=anthropic:claude-sonnet-5-5   # models.id와 같은 키. 예: anthropic:claude-opus-5-5 · xai:grok-4.7 · 키 없이: fake
LLM_FALLBACK_MODEL=                     # 예: anthropic:claude-haiku-5-5
OPENAI_API_KEY=
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
AGENT_CHECKPOINT_DB=./db/agent_checkpoints.db
AGENT_TASK_DB=./db/agent_tasks.db

# Slack 봇 (apps/slack_bot/README.md)
SLACK_USER_MAP=
SLACK_ADMIN_USER_IDS=
SYSTEM_TOKEN=dev.sys
# Slack 봇 워커: F1(업데이트 검토→제안 발송)을 자동으로 돌릴 주기(분). 0이면 수동(--run-f1)만
F1_INTERVAL_MIN=0
# 인증 (backend)
APP_ENV=dev                  # prod면 dev.<id> 토큰과 /auth/dev-login이 막힌다
JWT_SECRET=                  # prod 필수. 비우면 개발용 기본값
JWT_TTL_MINUTES=60
