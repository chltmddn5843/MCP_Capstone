ANTHROPIC_API_KEY=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
BACKEND_URL=http://localhost:8000
AGENT_URL=http://localhost:8002
MCP_WORK_URL=http://localhost:8010/mcp
MCP_DOCS_URL=http://localhost:8011/mcp
DATABASE_URL=postgresql+psycopg://capstone:capstone@localhost:5432/capstone
POSTGRES_USER=capstone
POSTGRES_PASSWORD=capstone
POSTGRES_DB=capstone

# 에이전트 런타임
LLM_MODEL=anthropic:claude-opus-4-7     # OpenAI: openai:gpt-5.2 · xAI: xai:grok-4.7 · 키 없이: fake
LLM_FALLBACK_MODEL=                     # 예: openai:gpt-5.2
OPENAI_API_KEY=
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
AGENT_CHECKPOINT_DB=./db/agent_checkpoints.db
AGENT_TASK_DB=./db/agent_tasks.db

# 인증 (backend)
APP_ENV=dev                  # prod면 dev.<id> 토큰과 /auth/dev-login이 막힌다
JWT_SECRET=                  # prod 필수. 비우면 개발용 기본값
JWT_TTL_MINUTES=60
