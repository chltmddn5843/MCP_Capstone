{
  "openapi": "3.1.0",
  "info": {
    "title": "Agent Runtime",
    "version": "0.2.0"
  },
  "paths": {
    "/ai/tasks": {
      "post": {
        "summary": "Create Task",
        "operationId": "create_task_ai_tasks_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskCreate"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_TaskCreated_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List Tasks",
        "operationId": "list_tasks_ai_tasks_get",
        "parameters": [
          {
            "name": "mine",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "title": "Mine"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_list_Task__"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/ai/tasks/{task_id}": {
      "get": {
        "summary": "Get Task",
        "operationId": "get_task_ai_tasks__task_id__get",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Task Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_Task_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/ai/tasks/{task_id}/stream": {
      "get": {
        "summary": "Stream Task",
        "operationId": "stream_task_ai_tasks__task_id__stream_get",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Task Id"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "description": "이 seq 이후 이벤트부터",
              "default": 0,
              "title": "After"
            },
            "description": "이 seq 이후 이벤트부터"
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/ai/tasks/{task_id}/approval": {
      "post": {
        "summary": "Approve Task",
        "operationId": "approve_task_ai_tasks__task_id__approval_post",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Task Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprovalDecision"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope_TaskCreated_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApprovalCard": {
        "properties": {
          "tool_name": {
            "type": "string",
            "title": "Tool Name"
          },
          "tool_input": {
            "additionalProperties": true,
            "type": "object",
            "title": "Tool Input"
          },
          "plan_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Plan Id"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "risk_level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Risk Level"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "Evidence",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "tool_name",
          "tool_input",
          "summary"
        ],
        "title": "ApprovalCard",
        "description": "APPROVAL_REQUIRED 이벤트와 승인 화면이 쓰는 내용."
      },
      "ApprovalDecision": {
        "properties": {
          "approved": {
            "type": "boolean",
            "title": "Approved"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "title": "Reason",
            "description": "승인·거절 모두 사유 필수"
          }
        },
        "type": "object",
        "required": [
          "approved",
          "reason"
        ],
        "title": "ApprovalDecision"
      },
      "Envelope_TaskCreated_": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/TaskCreated"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        },
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "title": "Envelope[TaskCreated]"
      },
      "Envelope_Task_": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Task"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        },
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "title": "Envelope[Task]"
      },
      "Envelope_list_Task__": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/Task"
            },
            "type": "array",
            "title": "Data"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        },
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "title": "Envelope[list[Task]]"
      },
      "Evidence": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source",
            "description": "예: usage_records, vendor_update, eval_results"
          },
          "ref": {
            "type": "string",
            "title": "Ref",
            "description": "예: 레코드 id, URL"
          },
          "value": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "type": "object",
        "required": [
          "source",
          "ref"
        ],
        "title": "Evidence",
        "description": "에이전트가 조치안·답변에 붙이는 근거 한 건."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Meta": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "request_id"
        ],
        "title": "Meta"
      },
      "Role": {
        "type": "string",
        "enum": [
          "employee",
          "admin",
          "system"
        ],
        "title": "Role",
        "description": "v2: 직원·관리자·시스템. 관리자는 자산·보안·승인 권한을 함께 가진다 (docs/설계문서.md 3절)."
      },
      "Task": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "thread_id": {
            "type": "string",
            "title": "Thread Id"
          },
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          },
          "requester_id": {
            "type": "string",
            "title": "Requester Id"
          },
          "requester_role": {
            "$ref": "#/components/schemas/Role"
          },
          "channel": {
            "type": "string",
            "title": "Channel"
          },
          "input": {
            "type": "string",
            "title": "Input"
          },
          "intent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Intent"
          },
          "feature_route": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Feature Route",
            "default": []
          },
          "workflow": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Workflow",
            "default": []
          },
          "tool_calls": {
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            },
            "type": "array",
            "title": "Tool Calls",
            "default": []
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TaskResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "approval": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ApprovalCard"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "turns": {
            "type": "integer",
            "title": "Turns",
            "default": 0
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "task_id",
          "thread_id",
          "trace_id",
          "status",
          "requester_id",
          "requester_role",
          "channel",
          "input",
          "created_at",
          "updated_at"
        ],
        "title": "Task"
      },
      "TaskCreate": {
        "properties": {
          "input": {
            "type": "string",
            "title": "Input",
            "description": "사용자 질문 또는 요청"
          },
          "thread_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thread Id",
            "description": "있으면 같은 대화(checkpointer thread)를 이어간다"
          },
          "prompt_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt Name",
            "description": "MCP Prompt 이름. 예: investigate_anomaly, review_update"
          },
          "prompt_args": {
            "additionalProperties": true,
            "type": "object",
            "title": "Prompt Args",
            "default": {}
          },
          "channel": {
            "type": "string",
            "enum": [
              "slack",
              "admin_ui",
              "system"
            ],
            "title": "Channel",
            "default": "admin_ui"
          }
        },
        "type": "object",
        "required": [
          "input"
        ],
        "title": "TaskCreate"
      },
      "TaskCreated": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "thread_id": {
            "type": "string",
            "title": "Thread Id"
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          }
        },
        "type": "object",
        "required": [
          "task_id",
          "thread_id",
          "status"
        ],
        "title": "TaskCreated"
      },
      "TaskResult": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "Evidence",
            "default": []
          },
          "plan_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Plan Id"
          },
          "suggested_actions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Suggested Actions",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "answer"
        ],
        "title": "TaskResult"
      },
      "TaskStatus": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "waiting_approval",
          "done",
          "failed"
        ],
        "title": "TaskStatus"
      },
      "ToolCall": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "input": {
            "additionalProperties": true,
            "type": "object",
            "title": "Input"
          },
          "output": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output",
            "description": "길이 제한된 도구 결과"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "destructive": {
            "type": "boolean",
            "title": "Destructive",
            "default": false
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "input",
          "started_at"
        ],
        "title": "ToolCall"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}