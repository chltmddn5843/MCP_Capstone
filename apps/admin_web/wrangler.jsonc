// Cloudflare Workers 배포 (고정 주소 https://nodi-admin.<계정>.workers.dev).
// 화면(dist)은 정적 자산으로 바로 내고, /api/* 만 worker.js가 로컬 서버(Quick Tunnel)로 넘긴다.
// GitHub 연동(Workers Builds): 루트 apps/admin_web, 빌드 npm run build, 배포 npx wrangler deploy. 이름은 아래 name과 같아야 한다.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nodi-admin",
  "main": "worker.js",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "TUNNEL", "id": "03329001234647bb88e29f8b56a35027" }
  ]
}
